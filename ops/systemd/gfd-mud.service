# DragonsNShit MUD — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/gfd-mud.service ~/.config/systemd/user/
#   GOWORK=off go build -o /home/fatbaby/GoblinFoxDragon/mud ./apps2/mud
#   systemctl --user daemon-reload
#   systemctl --user enable --now gfd-mud.service
#
# Added 2026-07-23 — founder asked to start playing the MUD; the binary
# existed (built 2026-06-27) but had never been run under supervision, only
# ever built and left on disk. GOWORK=off is required: this repo is not a
# workspace module (see /home/fatbaby/CLAUDE.md's Non-Workspace Repos table),
# and the root monorepo's go.work being visible via $GOWORK breaks the build
# otherwise ("directory ... is contained in a module that is not one of the
# workspace modules").
#
# Connect: telnet <host> 2323  (or nc <host> 2323) — plain-text MUD protocol,
# no special client needed. World-event HTTP API (Emily Prime injection +
# recent-events feed, plus the newer /api/town/command headless-session
# endpoint) on :7171, used by the status-page check below.
#
# Real bug found live 2026-08-02, GoblinFoxDragon's Town avatar/combat work: this unit never had
# IDUNA_AGENT_NAME/IDUNA_AGENT_SECRET set at all (no EnvironmentFile= line existed), so every
# idunaclient call this process has ever made (GetCharacter/CreateCharacter/UpdatePosition/
# CreditGold/DeductGold) was silently failing with a 401 -- masked entirely by every call site's
# own "best-effort, non-blocking" error handling, same shape as the earlier `do()`-sends-secret-
# as-bearer-token bug (idunaclient.go's own doc comment, fixed 2026-07-31) but a plain
# configuration gap this time, not a code bug. Fixed by pointing at a real, git-ignored env file
# (same convention iduna.service already uses for its own secrets):
#   mkdir -p ~/.config/gfd-mud
#   cat > ~/.config/gfd-mud/env <<'ENV'
#   IDUNA_AGENT_NAME=DRAGONSNSHIT-MUD
#   IDUNA_AGENT_SECRET=<IDUNA_SECRET_DRAGONSNSHIT_MUD from IDUNA/var/agent-secrets.env>
#   ENV
#   chmod 600 ~/.config/gfd-mud/env
#
# RECURRED 2026-09-12: founder real-time report ("ssh login kinda works... presents us with the
# warning about the character not saving (should not be seeing this)") traced back to this EXACT
# same gap -- ~/.config/gfd-mud/env did not exist on disk at all (confirmed: `ls` on it returned
# "No such file or directory"), so IDUNA_AGENT_NAME/IDUNA_AGENT_SECRET were unset for this run,
# `idunaclient.Client.do()` sent every request with no Authorization header at all (see that
# package's own doc comment: `do()` only calls `ensureToken`/sets the header `if c.agentSecret !=
# ""`), and every real SSH connection got `[ssh] fingerprint lookup failed, falling back to guest:
# idunaclient: server error: status 401` -- silently reproducing the exact 2026-08-02 bug this
# comment already documents, not a new one. Root cause of the recurrence: this file lives
# deliberately OUTSIDE the repo (it's a secret, correctly git-ignored) and outside
# GoblinFoxDragon/var (so it is NOT covered by the `emily backup run --target gfd` path either,
# `emily.cli/cmd/backup.go`'s own `gfd` target only tars `GoblinFoxDragon/var`) -- when this box's
# $HOME state was reset/recreated at some point this session (confirmed: `~/.config`, `~/.ssh`,
# `~/.bashrc` etc. all showed as untracked-from-scratch in git status), this one file had no
# backup anywhere to restore from and silently vanished. Re-created from the real secret in
# `IDUNA/var/agent-secrets.env` (`IDUNA_SECRET_DRAGONSNSHIT_MUD`) and live-verified end to end:
# fresh SSH key -> claim flow -> `[ssh-claim] new identity claimed` -> reconnect with the same key
# -> `[ssh] known fingerprint, resuming character=...` (not another guest fallback). Real, honest,
# NOT fixed as part of this pass: there is still no backup coverage for this file anywhere in the
# monorepo, so this can recur again exactly the same way after another $HOME reset -- flagged in
# EMILY/BACKLOG.md rather than silently building a new encrypted-secrets-backup mechanism
# unprompted (this file's own secret is exactly the class of thing `looksLikeSecret`/`Encrypt:
# false` on the plain `gfd` backup target was built to keep OUT of an unencrypted backup, so
# fixing the gap properly needs a real encrypted path, not just adding this file to the existing
# target).
#
# Sandboxing directives below added 2026-09-12 (SSH_TRANSPORT_IDENTITY_SPEC.md §5 / Stage 3,
# docs2/SSH_TRANSPORT_IDENTITY_NORTHSTAR.md) -- real, honest, found-live limit: this is a
# `systemctl --user` unit, so it runs inside the normal, unprivileged per-user systemd instance
# (user@1000.service), which itself never holds CAP_SETPCAP -- confirmed live by testing each
# directive individually on a throwaway instance before touching this file. Any directive whose
# enforcement mechanism is "drop a specific capability from the bounding set"
# (CapabilityBoundingSet=, AmbientCapabilities=, ProtectKernelModules=, ProtectKernelLogs=,
# ProtectClock=) fails with `status=218/CAPABILITIES` here -- not because this box denies them,
# but because only a root-held systemd instance can perform that operation at all, for any unit.
# A real system-level unit (root-owned, running as a dedicated unprivileged system account) would
# not have this limit and could add those directives plus the "no login shell" requirement §5
# itself asks for -- scoped, not yet built, see the sudo-queue script this same commit adds.
# Everything below IS achievable in a `--user` unit and was live-verified (throwaway instance,
# real telnet connect + real var/ write, `systemd-analyze security` exposure score 9.8 UNSAFE ->
# 5.8 MEDIUM) before being applied here.

[Unit]
Description=DragonsNShit MUD (GoblinFoxDragon apps2/mud)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/GoblinFoxDragon
EnvironmentFile=-%h/.config/gfd-mud/env
ExecStart=/home/fatbaby/GoblinFoxDragon/mud -port 2323 -api-port 7171
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/fatbaby/GoblinFoxDragon/var/logs/mud.log
StandardError=append:/home/fatbaby/GoblinFoxDragon/var/logs/mud.log
MemoryMax=512M

# Filesystem: read-only everywhere except the one real data path (spec §5's own core ask).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/fatbaby/GoblinFoxDragon/var
PrivateTmp=yes

# No privilege escalation; no new capabilities can ever be gained mid-run.
NoNewPrivileges=yes

# Namespace/kernel-surface restriction achievable without CAP_SETPCAP.
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes

# This process only ever needs plain TCP (telnet :2323, world-event API :7171, outbound calls to
# IDUNA) -- no raw/packet/netlink sockets, no other address family.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Baseline syscall allowlist (mount/module/reboot/etc. denied) -- does not itself need
# CAP_SETPCAP, seccomp filters apply regardless of the calling process's own capabilities.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

UMask=0077

[Install]
WantedBy=default.target
