# Ignore build artifacts
bin/
obj/
release_server/
release_client/
*.exe
*.dll
*.o
*.a
*.so
*.zip
__pycache__/
*.pyc

# Ignore Colab/Jupyter garbage
.ipynb_checkpoints/

# Ignore local config
.ssh/

# Runtime-generated (logs, MUD server state) -- not source
var/

# Local pre-rollout backup tarballs of var/ (SSH_TRANSPORT_IDENTITY spec Stage 3) -- contains
# var/moltbook-credentials.json verbatim (real credentials), never committed.
var-backups/